{
  "kind": "collectionType",
  "collectionName": "catalog_collections",
  "info": {
    "singularName": "catalog-collection",
    "pluralName": "catalog-collections",
    "displayName": "Подборка товаров"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "sortOrder": {
      "type": "integer"
    },
    "selectionMode": {
      "type": "enumeration",
      "enum": [
        "manual",
        "category",
        "discount",
        "new"
      ]
    },
    "noveltyDays": {
      "type": "integer",
      "default": 100,
      "min": 1
    },
    "noveltyBadgeColor": {
      "type": "string",
      "default": "#2eae4a"
    },
    "isHiddenInMenu": {
      "type": "boolean",
      "default": false
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::moysklad-product.moysklad-product",
      "inversedBy": "catalog_collections"
    },
    "sourceCategory": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::moysklad-category.moysklad-category"
    }
  },
  "config": {
    "metadatas": {
      "selectionMode": {
        "edit": {
          "label": "Режим подборки",
          "description": "Выберите, откуда брать товары: вручную, из категории, со скидкой или из новинок."
        }
      },
      "noveltyDays": {
        "edit": {
          "label": "Период новинок на сайте",
          "description": "Срок автоматического показа в днях. Товары, выбранные вручную ниже, остаются в новинках независимо от этого срока."
        }
      },
      "noveltyBadgeColor": {
        "edit": {
          "label": "Цвет бейджа «Новинка»",
          "description": "Укажите HEX-код. Например: #2EAE4A."
        }
      },
      "products": {
        "edit": {
          "label": "Товары вручную",
          "description": "В режиме new добавляются к автоматическим новинкам без ограничения по сроку. Удаление из списка снимает закрепление; новые по дате товары останутся до окончания срока. Уценка и скрытые товары не показываются. В режиме manual этот список задаёт весь состав подборки. После изменения нажмите «Опубликовать»."
        }
      },
      "sourceCategory": {
        "edit": {
          "label": "Категория",
          "description": "Выберите категорию-источник."
        }
      },
      "isHiddenInMenu": {
        "edit": {
          "label": "Скрыть в меню каталога",
          "description": "Подборка не отображается в меню “Каталог”, но её страница и другие блоки продолжают работать."
        }
      }
    }
  }
}
