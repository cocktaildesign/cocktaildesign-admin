{
  "kind": "collectionType",
  "collectionName": "site_order_journals",
  "info": { "singularName": "site-order-journal", "pluralName": "site-order-journals", "displayName": "Заявки сайта", "description": "Резерв заявок. Требующие проверки обрабатываются менеджером; автоматической повторной отправки в CRM нет." },
