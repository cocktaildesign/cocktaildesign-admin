{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Главная страница",
    "description": "Баннеры и товарные подборки главной страницы"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "collectionAfterShortcuts": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::catalog-collection.catalog-collection"
    },
    "saleCollectionAfterTelegram": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::catalog-collection.catalog-collection"
    },
    "collectionAfterKnowledge": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::catalog-collection.catalog-collection"
    },
    "collectionAfterBanners": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::catalog-collection.catalog-collection"
    },
    "heroBanners": {
      "type": "component",
      "repeatable": true,
      "component": "homepage.hero-banner",
      "max": 6
    },
    "promoBanners": {
      "type": "component",
      "repeatable": true,
      "component": "homepage.promo-banner",
      "max": 6
    }
  },
  "config": {
    "metadatas": {
      "heroBanners": {
        "edit": {
          "label": "Верхние баннеры",
          "description": "До 6 баннеров. Перетащите для изменения порядка. Save сохраняет черновик; Publish обновляет сайт примерно за 1–2 минуты."
        }
      },
      "promoBanners": {
        "edit": {
          "label": "Нижние баннеры",
          "description": "До 6 баннеров. Перетащите для изменения порядка. Save сохраняет черновик; Publish обновляет сайт примерно за 1–2 минуты."
        }
      }
    }
  }
}
