{
  "kind": "collectionType",
  "collectionName": "moysklad_products",
  "info": {
    "singularName": "moysklad-product",
    "pluralName": "moysklad-products",
    "displayName": "Товары"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "specifications": {
      "type": "component",
      "component": "product.harakteristika",
      "repeatable": true,
      "required": true
    },
    "moyskladId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "composition": {
      "type": "text"
    },
    "hideBundleContents": {
      "type": "boolean",
      "default": false
    },
    "engravingEnabled": {
      "type": "boolean",
      "default": false
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::moysklad-category.moysklad-category",
      "inversedBy": "products"
    },
    "price": {
      "type": "integer"
    },
    "priceOld": {
      "type": "integer"
    },
    "uom": {
      "type": "string"
    },
    "weight": {
      "type": "decimal"
    },
    "volume": {
      "type": "decimal"
    },
    "href": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "updated": {
      "type": "datetime"
    },
    "moyskladCreatedAt": {
      "type": "datetime"
    },
    "moyskladNoveltyAt": {
      "type": "datetime"
    },
    "searchText": {
      "type": "text"
    },
    "searchCodes": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "lockImages": {
      "type": "boolean",
      "default": true
    },
    "displayTitle": {
      "type": "string"
    },
    "catalog_collections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::catalog-collection.catalog-collection",
      "mappedBy": "products"
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "product",
      "enum": [
        "product",
        "bundle"
      ]
    },
    "bundleComponentItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::moysklad-bundle-item.moysklad-bundle-item",
      "mappedBy": "componentProduct"
    },
    "bundleItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::moysklad-bundle-item.moysklad-bundle-item",
      "mappedBy": "bundle"
    },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::moysklad-variant.moysklad-variant",
      "mappedBy": "product"
    },
    "badges": {
      "type": "component",
      "component": "catalog.product-badge-assignment",
      "repeatable": true,
      "required": false
    },
    "discountExcluded": {
      "type": "boolean",
      "default": false
    },
    "isHiddenOnSite": {
      "type": "boolean",
      "default": false
    },
    "moyskladStock": {
      "type": "decimal"
    },
    "isOutOfStock": {
      "type": "boolean"
    }
  },
  "config": {
    "metadatas": {
      "hideBundleContents": {
        "edit": {
          "label": "Скрыть состав комплекта на сайте",
          "description": "Скрывает список и карточки составляющих. Сам товар продаётся целиком; состав и учёт в МойСклад не меняются. Например, для дропперов."
        }
      },
      "searchText": {
        "edit": {
          "label": "Поисковый текст",
          "description": "Заполняется автоматически.",
          "editable": false
        }
      },
      "searchCodes": {
        "edit": {
          "label": "Поисковые артикулы",
          "description": "Заполняются автоматически.",
          "editable": false
        }
      },
      "badges": {
        "edit": {
          "label": "Бейджи",
          "description": "Выберите бейджи для карточки. Например: «Хит»."
        }
      },
      "moyskladStock": {
        "edit": {
          "label": "Остаток в МойСклад",
          "description": "Физический остаток из МойСклад. Поле обновляется синхронизацией. Не изменяйте вручную."
        }
      },
      "isOutOfStock": {
        "edit": {
          "label": "Нет в наличии",
          "description": "Системный флаг. Товар скрывается при нулевом или отрицательном остатке. Не изменяйте вручную."
        }
      }
    }
  }
}
